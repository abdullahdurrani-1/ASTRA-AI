# Copy to .env and fill in only what you need. Never commit .env.
# With no changes, Astra runs fully offline in clearly-labelled MOCK mode.

APP_ENV=development
LOG_LEVEL=INFO
# DATA_DIR=./data                 # uploads, SQLite DB and Chroma index (git-ignored)
# DATABASE_URL=                   # default: sqlite in DATA_DIR; e.g. postgresql+psycopg://...
MAX_UPLOAD_MB=25

# --- Embeddings: mock | openai | sentence_transformers -------------------------
# Changing provider/model requires re-indexing documents (Retry/reindex button or API).
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=                  # openai default text-embedding-3-small;
                                  # sentence_transformers default paraphrase-multilingual-MiniLM-L12-v2

# --- LLM: mock | anthropic | openai --------------------------------------------
LLM_PROVIDER=mock
# Model per role. IDs live here only, never in code. Confirm current IDs/pricing at
# https://docs.claude.com before pinning. Suggested (Anthropic, Oct 2026): answer=claude-sonnet-5-5,
# router=claude-haiku-5-5, judge=claude-opus-5-5, fallback=claude-opus-5-5.
LLM_MODEL_ANSWER=                 # grounded answers (required for real providers)
LLM_MODEL_ROUTER=                 # intent classifier, stage 2 (required in production)
LLM_MODEL_JUDGE=                  # evaluation faithfulness judge (use a different model than ANSWER)
LLM_MODEL_FALLBACK=               # retried once if the answer model errors
LLM_MODEL=                        # legacy: used only if LLM_MODEL_ANSWER is empty
LLM_MAX_RETRIES=2                 # retries on 429/5xx with jittered backoff
LLM_REASONING_EFFORT=low          # none|minimal|low|medium|high; empty = provider default (Gemini 3.x thinks for 30 s+ by default)
INTENT_CLASSIFIER_ENABLED=true
ALLOW_GENERAL_KNOWLEDGE=false     # product decision: keep off unless the owner approves
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Retrieval / evidence gate (calibrate per embedding model, see docs/EVALUATION.md)
RETRIEVAL_TOP_K=6
MIN_VECTOR_SIMILARITY=0.45
MIN_KEYWORD_COVERAGE=0.6

# --- Voice: disabled | openai (typed chat always works without these) ----------
STT_PROVIDER=disabled
STT_MODEL=
TTS_PROVIDER=disabled
TTS_MODEL=
TTS_VOICE=alloy

# --- Optional Gemini code reviewer (developer tool, off by default) ------------
GEMINI_REVIEW_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=                     # set from Google's current model list; not hard-coded

# --- OCR for scanned PDFs (requires Tesseract: winget install UB-Mannheim.TesseractOCR)
OCR_ENABLED=false
OCR_LANGUAGES=eng                 # e.g. eng+urd (install the urd language data first)
OCR_DPI=300
TESSDATA_DIR=                     # Windows: C:/Program Files/Tesseract-OCR/tessdata
